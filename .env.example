# Plugin (Vite) — copy to .env.local

# Cloudflare Worker (required for release builds; also powers /verify-fetch for
# published-site verification — Framer sites block direct plugin fetches).
# Production builds should use the approved Polyglot AEO domain, not workers.dev.
# VITE_LICENSE_API_BASE=https://license.polyglotaeo.com
# Marketplace/release builds should keep managed AI enabled. Set this to false
# only for private dev builds that intentionally test legacy direct-provider
# adapters.
# VITE_MANAGED_AI=true

# Optional emergency fallback. By default the plugin opens
# {VITE_LICENSE_API_BASE}/checkout so the Worker creates fresh Creem sessions.
# VITE_CREEM_CHECKOUT_MONTHLY=https://www.creem.io/payment/prod_XXXX
# VITE_CREEM_CHECKOUT_YEARLY=https://www.creem.io/payment/prod_YYYY

# Sandbox checkout/license activation. Use only for local testing, never for a
# Marketplace/release build. The production Worker ignores client test_mode.
# Sandbox purchases also require the Worker itself to run with
# CREEM_TEST_MODE=true and a non-production ENVIRONMENT.
# VITE_CREEM_TEST_MODE=true
# VITE_SHOW_BILLING_TEST_MODE=true

# Local-only revenue monitoring. Do not expose this as VITE_* or commit it.
# CREEM_API_KEY=creem_live_XXXX
# CREEM_TEST_API_KEY=creem_test_XXXX

# Local dev without Worker:
# VITE_DEV_PRO=true

# Optional
# VITE_SCHEMA_RULES_URL=https://polyglotaeo.com/schema-rules-v1.json
# VITE_SENTRY_DSN=

# Local-only report-first outreach sender gate. Never expose these as VITE_*.
# Use a company-domain sender with SPF, DKIM, and DMARC already configured.
# OUTREACH_SENDER_EMAIL=you@example.com
# OUTREACH_DKIM_SELECTOR=resend
# SENDER_POSTAL_ADDRESS=Your valid business mailing address
# RESEND_API_KEY=re_xxxx

{
  "name": "polyglot-aeo",
  "private": true,
  "version": "0.1.0",
  "description": "Multilingual AEO & structured data plugin for Framer — get cited by ChatGPT, Perplexity, Claude, and Google AI Overviews in every language.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:locale-maps": "tsx scripts/generate-locale-glyph-maps.ts",
    "check:locale-maps": "npm run generate:locale-maps && git diff --exit-code -- src/lib/locale-script/data src/lib/locale-script/prompt-samples.ts",
    "prebuild": "npm run generate:locale-maps",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "pack": "npx framer-plugin-tools@latest pack",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "framer-plugin": "^3.10.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-plugin-mkcert": "^1.17.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "opencc-js": "^1.3.1",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vite": "^6.0.0",
    "vite-plugin-framer": "^1.0.7",
    "vitest": "^4.1.5"
  }
}
